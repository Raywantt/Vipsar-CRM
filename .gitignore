# Dependencies
node_modules

# Local Claude Code tooling config (machine-specific, not part of the app)
.claude/

# Build output
dist
dist-ssr
dev-dist
*.local

# Environment variables (Supabase keys, etc. — never commit these)
.env
.env.*
!.env.example

# Data migration working files — frozen CRM exports, import/rollback scripts
# and audit spreadsheets. These carry REAL customer records (names, mobiles,
# addresses) and this repository is public, so they must never be committed.
backup/

# Supabase CLI local state (which project is linked, etc.) — machine-specific
supabase/.temp/
supabase/.branches/

# Playwright screenshot tooling (scripts/shoot.mjs) — .auth holds real Supabase
# session tokens per role, screenshots capture real lead/employee data from the
# live DB. This repo is public, so neither belongs in a tracked commit.
scripts/.auth/
scripts/screenshots/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Real customer data — THIS REPOSITORY IS PUBLIC.
# The legacy-CRM import scripts and their source spreadsheets contain client
# names, mobile numbers and addresses for several hundred real people.
# Committing them would publish that to anyone on the internet, permanently
# (git history keeps it even after a later delete). Keep them local; run the
# SQL from the Supabase SQL Editor the same way every other migration is run.
# Migrations that carry NO customer data — e.g.
# migration_backfill_legacy_created_at.sql — are tracked normally.
Schema/import_*_legacy.sql
*.xlsx
